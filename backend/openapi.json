        "tags": [
          "Collections"
        ]
      }
    }
  },
  "info": {
    "title": "Bookmark manager API",
    "description": "The contract is described in API_DESIGN.md. Every route needs a Bearer token.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "A JSON Pointer into the request body."
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "detail"
        ]
      },
      "ValidationProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "errors"
        ]
      },
      "CollectionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "bookmarkCount": {
            "type": "number",
            "description": "How many of the Owner's Bookmarks are in this Collection."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "bookmarkCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "CollectionPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the next page. Null on the last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreateCollectionBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Trimmed. Unique per Owner, ignoring case.",
            "example": "Reading",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "ReplaceCollectionBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Trimmed. Unique per Owner, ignoring case.",
            "example": "Reading",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCollectionBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Trimmed. Unique per Owner, ignoring case. Absent means unchanged.",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "BookmarkDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "collectionId": {
            "type": "string",
            "nullable": true,
            "description": "Null for an Uncategorised Bookmark.",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Always a string, \"\" when empty."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "collectionId",
          "url",
          "title",
          "notes",
          "createdAt",
          "updatedAt"
        ]
      },
      "BookmarkPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookmarkDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the next page. Null on the last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreateBookmarkBody": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Trimmed, then stored as entered. http(s) only, with a host.",
            "example": "https://example.com/post",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "description": "Trimmed.",
            "minLength": 1,
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "description": "Stored exactly as sent. Defaults to \"\".",
            "maxLength": 2000
          },
          "collectionId": {
            "type": "string",
            "nullable": true,
            "description": "The Owner's Collection, or null (the default) for Uncategorised.",
            "format": "uuid"
          }
        },
        "required": [
          "url",
          "title"
        ]
      },
      "ReplaceBookmarkBody": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Trimmed, then stored as entered. http(s) only, with a host.",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "description": "Trimmed.",
            "minLength": 1,
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "description": "Stored exactly as sent.",
            "maxLength": 2000
          },
          "collectionId": {
            "type": "string",
            "nullable": true,
            "description": "The Owner's Collection, or null for Uncategorised. Must be sent.",
            "format": "uuid"
          }
        },
        "required": [
          "url",
          "title",
          "notes",
          "collectionId"
        ]
      },
      "UpdateBookmarkBody": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Trimmed, then stored as entered. http(s) only, with a host.",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "description": "Trimmed.",
            "minLength": 1,
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "description": "Stored exactly as sent.",
            "maxLength": 2000
          },
          "collectionId": {
            "type": "string",
            "nullable": true,
            "description": "The Owner's Collection, or null to make the Bookmark Uncategorised.",
            "format": "uuid"
          }
        }
      }
    }
  }
