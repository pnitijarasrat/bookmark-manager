# Copied to .env on `npm install` (and by the root `npm run dev`) if .env
# doesn't exist.
# None of these are secrets: they describe the public Auth0 tenant and the
# local Docker Compose database.
DATABASE_URL=postgresql://bookmarks:bookmarks@localhost:5434/bookmarks
AUTH0_ISSUER=https://dev-yg.us.auth0.com/
AUTH0_AUDIENCE=https://bbl-candidate-test-api
AUTH0_JWKS_URL=https://dev-yg.us.auth0.com/.well-known/jwks.json
PORT=3001
